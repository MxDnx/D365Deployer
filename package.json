{
  "name": "d365-deployer",
  "displayName": "D365 Deployer",
  "description": "Deploy web resources and packages to Dynamics 365 CE directly from the VS Code explorer context menu.",
  "version": "1.0.3",
  "publisher": "MxDnx",
  "icon": "images/logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "d365WebResourceDeployer.deployFile",
        "title": "Deploy to D365"
      },
      {
        "command": "d365WebResourceDeployer.deployAll",
        "title": "Deploy All to D365"
      },
      {
        "command": "d365WebResourceDeployer.diagnose",
        "title": "D365: Diagnose Settings"
      },
      {
        "command": "d365WebResourceDeployer.deployPackageToCrm",
        "title": "Deploy Package To CRM"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "d365WebResourceDeployer.deployFile",
          "when": "!explorerResourceIsFolder && (resourcePath =~ /[/\\\\]src[/\\\\]/ && resourcePath =~ /\\.(form|ribbon)\\.ts$/ || resourcePath =~ /[/\\\\]src[/\\\\]static[/\\\\]/)",
          "group": "navigation@1"
        },
        {
          "command": "d365WebResourceDeployer.deployAll",
          "when": "explorerResourceIsFolder && resourcePath =~ /[/\\\\]src([/\\\\]|$)/",
          "group": "navigation@1"
        },
        {
          "command": "d365WebResourceDeployer.deployPackageToCrm",
          "when": "explorerResourceIsFolder",
          "group": "1_build@3"
        }
      ]
    },
    "configuration": {
      "title": "D365 Deployer",
      "properties": {
        "d365WebResourceDeployer.publisherName": {
          "type": "string",
          "default": "",
          "description": "Nom complet de l'éditeur (ex: Mx Dynamics)"
        },
        "d365WebResourceDeployer.publisherPrefix": {
          "type": "string",
          "default": "",
          "description": "Préfixe de l'éditeur (ex: mx)"
        },
        "d365WebResourceDeployer.solutionUniqueName": {
          "type": "string",
          "default": "",
          "description": "Nom unique de la solution (ex: FormScript)"
        },
        "d365WebResourceDeployer.preDeploymentLocalScript": {
          "type": "string",
          "default": "",
          "description": "Script npm à exécuter avant le déploiement (ex: build:dev). Laisser vide pour ignorer."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository",
    "ship": "npm run compile && npm run package && node scripts/install-vsix.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.3.0"
  }
}
